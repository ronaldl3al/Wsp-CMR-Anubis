# ==============================================================================
# Variables de Entorno para Chatwoot en Railway
# ==============================================================================

# 1. Modo de Producción
RAILS_ENV=production
NODE_ENV=production
INSTALLATION_ENV=docker
RAILS_SERVE_STATIC_FILES=true
RAILS_LOG_TO_STDOUT=true

# 2. Clave secreta (Cadena hexadecimal larga aleatoria de 64 caracteres)
# Generable con: openssl rand -hex 64 o cualquier generador seguro
SECRET_KEY_BASE=c14e0b0b00da049ebcfae868a2ec3da6b3d11b23fb3911c471ba82e0e5616f72

# 3. URL Pública de la Aplicación (El dominio que Railway le asigne a Chatwoot)
FRONTEND_URL=https://wsp-cmr-anubis-production.up.railway.app

# 4. Habilitar registro inicial (Poner en true al desplegar para crear tu cuenta de admin)
ENABLE_ACCOUNT_SIGNUP=true

# 5. Base de Datos (PostgreSQL 16 + pgvector)
# Si agregas el plugin oficial de PostgreSQL en Railway, Railway define DATABASE_URL automáticamente.
# Nuestro entrypoint se encarga de parsear automáticamente el host, usuario, password y database.
DATABASE_URL=${{Postgres.DATABASE_URL}}

# 6. Redis (Caché y Colas en Tiempo Real)
# Si agregas el plugin oficial de Redis en Railway, Railway define REDIS_URL automáticamente.
REDIS_URL=${{Redis.REDIS_URL}}

# 7. Sidekiq (Worker en Segundo Plano)
# Por defecto está habilitado dentro del mismo contenedor para ahorrar recursos
RUN_SIDEKIQ=true
SIDEKIQ_CONCURRENCY=5

# 8. Puerto
PORT=3000
